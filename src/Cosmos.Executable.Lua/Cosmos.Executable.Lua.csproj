<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A plain .NET library, like Cosmos.Network.Ftp: the interpreter uses
    System.IO and System.Console and nothing from Cosmos. A Cosmos Gen3 kernel
    runs it on the kernel's VFS and console sessions through the plugs, and on
    a desktop it runs as is, which is how the tests drive it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Cosmos.Executable.Lua</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Cosmos.Executable.Lua</PackageId>
    <Version>2.0.0</Version>
    <Title>Cosmos.Executable.Lua</Title>
    <Authors>Cosmos</Authors>
    <Company>Cosmos</Company>
    <Description>Lua 5.3 interpreter for Cosmos Gen3 kernels, based on UniLua.</Description>
    <PackageTags>cosmos;lua;interpreter;scripting;kernel</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/CosmosOS/Cosmos.Executable.Lua</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CosmosOS/Cosmos.Executable.Lua</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../LICENSE.txt" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../resources/icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cosmos.Executable.Lua.Tests" />
  </ItemGroup>

</Project>
