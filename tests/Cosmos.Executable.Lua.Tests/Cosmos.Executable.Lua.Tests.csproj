<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cosmos.Executable.Lua/Cosmos.Executable.Lua.csproj" />
  </ItemGroup>

  <!-- The files of the official Lua 5.5 test suite that LuaTestSuiteTests runs -->
  <ItemGroup>
    <None Include="lua-5.5-tests/*.lua" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
